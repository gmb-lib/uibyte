{
  "name": "uibyte",
  "version": "0.21.0",
  "description": "The gmb design system as code — role-named tokens, the application shell and the accessible primitives every gmb SPA is built from.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmb-lib/uibyte.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/theme/theme.css",
    "./fonts.css": "./src/theme/fonts.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "npm run typecheck && npm run test && npm run build",
    "theme": "vite-node scripts/generate-theme.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "^4.0.1",
      "glob": "^14.0.6"
    }
  }
}
